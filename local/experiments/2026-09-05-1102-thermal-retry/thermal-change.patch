-        return 0;
-    }
-
-    for (uint8_t chip_id = 0; chip_id < chip_count; chip_id++) {
-        uint32_t raw = 0;
-        if (mc3_read_register(chip_id, MC3_THERMAL_DOUT, &raw)) {
-            temps[chip_id] = mc3_temperature_from_dout(raw);
